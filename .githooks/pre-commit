#!/bin/sh
# Lints staged Kotlin files with ktlint, then runs detekt on them.
# Enable with: git config core.hooksPath .githooks

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_kt_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.kt' '*.kts')

if [ -z "$staged_kt_files" ]; then
  exit 0
fi

echo "Running ktlint on staged files..."
echo "$staged_kt_files" | xargs ./scripts/ktlint --relative || {
  echo "ktlint found issues. Fix them (ktlint can autofix with: ./scripts/ktlint -F <files>) and re-stage." >&2
  exit 1
}

echo "Running detekt on staged files..."
echo "$staged_kt_files" | tr '\n' ',' | sed 's/,$//' | xargs -I{} ./scripts/detekt --config detekt.yml --input {} || {
  echo "detekt found issues. Fix them and re-stage." >&2
  exit 1
}

exit 0
